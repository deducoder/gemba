{
  "tools": [
    {
      "name": "getJiraIssue",
      "description": "Get issue details. Use getTeamworkGraphContext to get linked deployments, PRs, builds, branches, commits, designs, issues, confluence whiteboards, feature flags, vulnerabilities, sprints and remote links to Jira Issues.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionSource": {
            "description": "Invocation attribution. Set to jira_mcp_card when called from a Jira MCP Widget UI; omit or set to model_tool_call for model/tool-loop calls.",
            "enum": [
              "jira_mcp_card",
              "model_tool_call"
            ],
            "type": "string"
          },
          "cloudId": {
            "description": "Cloud ID (UUID or site URL)",
            "type": "string"
          },
          "expand": {
            "description": "Additional issue details to expand in the response (for example, renderedFields or names).",
            "type": "string"
          },
          "failFast": {
            "description": "Whether to fail quickly when some fields cannot be loaded instead of partially returning data.",
            "type": "boolean"
          },
          "fields": {
            "description": "Issue fields to return. When omitted or empty, defaults to: summary, description, status, issuetype, priority, labels, components, assignee, reporter, created, updated, resolution, project. Pass \"*all\" to return every field (including custom fields). Include \"comment\" to fetch issue comments in fields.comment.comments.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fieldsByKeys": {
            "description": "Whether fields in the request are referenced by field keys instead of IDs.",
            "type": "boolean"
          },
          "issueIdOrKey": {
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)",
            "type": "string"
          },
          "properties": {
            "description": "Issue property keys to include in the response.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "responseContentFormat": {
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted.",
            "enum": [
              "markdown",
              "adf"
            ],
            "type": "string"
          },
          "updateHistory": {
            "description": "Whether to update the user's recently viewed projects/history for this issue request.",
            "type": "boolean"
          }
        },
        "required": [
          "cloudId",
          "issueIdOrKey"
        ]
      }
    },
    {
      "name": "createJiraIssue",
      "description": "Create a Jira issue. Use additional_fields to set any Jira field that does not have its own parameter (e.g. custom fields, priority, components).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "additional_fields": {
            "type": "object",
            "additionalProperties": {},
            "description": "REQUIRED for custom fields. This is the ONLY parameter to set priority, labels, custom fields, components, fix versions, or any other Jira fields not listed above. Pass a JSON object with field names as keys. Examples: {\"components\": [{\"name\": \"Backend\"}]}, {\"fixVersions\": [{\"name\": \"v1.2\"}]}, {\"priority\": {\"name\": \"High\"}}, {\"labels\": [\"bug\"]}, {\"customfield_10001\": \"value\"}."
          },
          "assignee_account_id": {
            "type": "string",
            "description": "Assignee ID"
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ],
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted."
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32000
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "doc"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ],
            "description": "Issue description. With contentFormat \"markdown\" (default), pass plain text or Markdown as a string. With contentFormat \"adf\", pass an ADF JSON string or a document object with type \"doc\"."
          },
          "issueTypeName": {
            "type": "string",
            "description": "Type (Task, Bug, Story)"
          },
          "parent": {
            "type": "string",
            "description": "Parent for subtasks"
          },
          "projectKey": {
            "type": "string",
            "description": "Project key"
          },
          "responseContentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ]
          },
          "summary": {
            "type": "string"
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "cloudId",
          "projectKey",
          "issueTypeName",
          "summary"
        ]
      }
    },
    {
      "name": "addOrEditJiraIssueComment",
      "description": "Add or update a comment on a Jira issue",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "commentBody": {
            "type": "string",
            "description": "Comment body"
          },
          "commentId": {
            "type": "string",
            "maxLength": 18,
            "description": "ID of an existing comment to update. If omitted, a new comment is added."
          },
          "commentVisibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "group",
                  "role"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ],
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted."
          },
          "issueIdOrKey": {
            "type": "string",
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)"
          },
          "responseContentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ]
          }
        },
        "required": [
          "cloudId",
          "issueIdOrKey",
          "commentBody"
        ]
      }
    },
    {
      "name": "executeRead",
      "description": "Execute a read-only operation by name (from discover, or already resolved; e.g. listJiraIssueTransitions).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The operation's name, from discover."
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": true,
            "description": "The operation's own inputs."
          }
        },
        "required": [
          "name",
          "cloudId",
          "inputs"
        ]
      }
    },
    {
      "name": "executeWrite",
      "description": "Execute a non-destructive write operation by name (from discover, or already resolved; e.g. createJiraIssueLink).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The operation's name, from discover."
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": true,
            "description": "The operation's own inputs."
          }
        },
        "required": [
          "name",
          "cloudId",
          "inputs"
        ]
      }
    },
    {
      "name": "executeDestructive",
      "description": "Execute a destructive operation by name (from discover, or already resolved; e.g. manageJiraProjectVersion).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The operation's name, from discover."
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": true,
            "description": "The operation's own inputs."
          }
        },
        "required": [
          "name",
          "cloudId",
          "inputs"
        ]
      }
    },
    {
      "name": "transitionJiraIssue",
      "description": "Transition issue status",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionSource": {
            "type": "string",
            "enum": [
              "jira_mcp_card",
              "model_tool_call"
            ],
            "description": "Invocation attribution. Set to jira_mcp_card when called from a Jira MCP Widget UI; omit or set to model_tool_call for model/tool-loop calls."
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {}
          },
          "historyMetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "activityDescription": {
                "type": "string"
              },
              "activityDescriptionKey": {
                "type": "string"
              },
              "actor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "avatarUrl": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              },
              "cause": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "avatarUrl": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              },
              "description": {
                "type": "string"
              },
              "descriptionKey": {
                "type": "string"
              },
              "emailDescription": {
                "type": "string"
              },
              "emailDescriptionKey": {
                "type": "string"
              },
              "extraData": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
