    {
      "name": "addWorklogToJiraIssue",
      "description": "Add or update a worklog on a Jira issue. When worklogId is provided, updates that worklog;",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "commentBody": {
            "type": "string",
            "description": "Comment body"
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ],
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted."
          },
          "issueIdOrKey": {
            "type": "string",
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)"
          },
          "started": {
            "type": "string",
            "description": "When the work was started (ISO 8601 date-time, e.g. 2026-03-09T09:00:00.000+0000). If omitted, the worklog is booked at the current date/time."
          },
          "timeSpent": {
            "type": "string",
            "description": "Time spent (e.g. 2h, 30m, 4d). Required for new worklogs; use to set or change time when updating."
          },
          "visibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "group",
                  "role"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          "worklogId": {
            "type": "string",
            "description": "ID of an existing worklog to update. If omitted, a new worklog is created."
          }
        },
        "required": [
          "cloudId",
          "issueIdOrKey",
          "timeSpent"
        ]
      }
    },
    {
      "name": "getConfluenceSpaces",
      "description": "Get spaces",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "keys": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Space keys"
          },
          "ids": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ],
            "description": "Space IDs"
          },
          "limit": {
            "type": "number",
            "description": "Max results (default: 25, max: 250)"
          }
        },
        "required": [
          "cloudId"
        ]
      }
    },
    {
      "name": "getConfluencePageDescendants",
      "description": "Get child pages of specified page",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "pageId": {
            "type": "string",
            "description": "Page or blog post ID, or a Confluence tiny link ID (the encoded part from /wiki/x/ URLs, e.g., Fc1bBw)"
          },
          "depth": {
            "type": "number",
            "description": "Max depth"
          },
          "limit": {
            "type": "number",
            "description": "Max descendants"
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor"
          }
        },
        "required": [
          "cloudId",
          "pageId"
        ]
      }
    },
    {
      "name": "createConfluencePage",
      "description": "Create a Confluence page or blog post.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "spaceId": {
            "type": "string",
            "description": "Numeric space ID (a Long, e.g. \"131073\"). A space key (e.g. \"ENG\") or personal-space key (e.g. \"~712020abc\") is also accepted and resolved to the numeric ID automatically."
          },
          "title": {
            "type": "string",
            "description": "Page or blog post title"
          },
          "body": {
            "type": "string",
            "description": "Page body."
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "html",
              "markdown",
              "adf"
            ],
            "description": "Body format."
          },
          "parentId": {
            "type": "string",
            "description": "ID of the parent to nest the new page under. Accepts the ID of any container that can hold a page, including a folder."
          },
          "subtype": {
            "type": "string",
            "enum": [
              "live"
            ],
            "description": "Page subtype (pages only, ignored for blogs)"
          }
        },
        "required": [
          "cloudId",
          "spaceId",
          "body"
        ]
      }
    },
    {
      "name": "updateConfluencePage",
      "description": "Update a Confluence page or blog post.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "pageId": {
            "type": "string",
            "description": "Page or blog post ID, or a Confluence tiny link ID (the encoded part from /wiki/x/ URLs, e.g., Fc1bBw)"
          },
          "title": {
            "type": "string",
            "description": "New title"
          },
          "body": {
            "type": "string",
            "description": "Replacement page body."
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "html",
              "markdown",
              "adf"
            ],
            "description": "Body format."
          },
          "versionMessage": {
            "type": "string",
            "description": "Version message"
          }
        },
        "required": [
          "cloudId",
          "pageId",
          "body"
        ]
      }
    },
    {
      "name": "getConfluencePage",
      "description": "Get a Confluence page or blog post by ID, including body content.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "pageId": {
            "type": "string",
            "description": "Page or blog post ID, or a Confluence tiny link ID (the encoded part from /wiki/x/ URLs, e.g., Fc1bBw)"
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "html",
              "markdown",
              "adf"
            ],
            "description": "Content format for page/comment body."
          },
          "contentType": {
            "type": "string",
            "enum": [
              "page",
              "blog"
            ],
            "description": "Type of content: page or blog post"
          }
        },
        "required": [
          "cloudId",
          "pageId"
        ]
      }
    }
  ]
}
