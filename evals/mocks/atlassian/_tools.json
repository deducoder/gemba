{
  "tools": [
    {
      "name": "getJiraIssue",
      "description": "Get issue details. Use getTeamworkGraphContext to get linked deployments, PRs, builds, branches, commits, designs, issues, confluence whiteboards, feature flags, vulnerabilities, sprints and remote links to Jira Issues.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionSource": {
            "description": "Invocation attribution. Set to jira_mcp_card when called from a Jira MCP Widget UI; omit or set to model_tool_call for model/tool-loop calls.",
            "enum": [
              "jira_mcp_card",
              "model_tool_call"
            ],
            "type": "string"
          },
          "cloudId": {
            "description": "Cloud ID (UUID or site URL)",
            "type": "string"
          },
          "expand": {
            "description": "Additional issue details to expand in the response (for example, renderedFields or names).",
            "type": "string"
          },
          "failFast": {
            "description": "Whether to fail quickly when some fields cannot be loaded instead of partially returning data.",
            "type": "boolean"
          },
          "fields": {
            "description": "Issue fields to return. When omitted or empty, defaults to: summary, description, status, issuetype, priority, labels, components, assignee, reporter, created, updated, resolution, project. Pass \"*all\" to return every field (including custom fields). Include \"comment\" to fetch issue comments in fields.comment.comments.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fieldsByKeys": {
            "description": "Whether fields in the request are referenced by field keys instead of IDs.",
            "type": "boolean"
          },
          "issueIdOrKey": {
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)",
            "type": "string"
          },
          "properties": {
            "description": "Issue property keys to include in the response.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "responseContentFormat": {
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted.",
            "enum": [
              "markdown",
              "adf"
            ],
            "type": "string"
          },
          "updateHistory": {
            "description": "Whether to update the user's recently viewed projects/history for this issue request.",
            "type": "boolean"
          }
        },
        "required": [
          "cloudId",
          "issueIdOrKey"
        ]
      }
    },
    {
      "name": "createJiraIssue",
      "description": "Create a Jira issue. Use additional_fields to set any Jira field that does not have its own parameter (e.g. custom fields, priority, components).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "additional_fields": {
            "type": "object",
            "additionalProperties": {},
            "description": "REQUIRED for custom fields. This is the ONLY parameter to set priority, labels, custom fields, components, fix versions, or any other Jira fields not listed above. Pass a JSON object with field names as keys. Examples: {\"components\": [{\"name\": \"Backend\"}]}, {\"fixVersions\": [{\"name\": \"v1.2\"}]}, {\"priority\": {\"name\": \"High\"}}, {\"labels\": [\"bug\"]}, {\"customfield_10001\": \"value\"}."
          },
          "assignee_account_id": {
            "type": "string",
            "description": "Assignee ID"
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ],
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted."
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32000
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "doc"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ],
            "description": "Issue description. With contentFormat \"markdown\" (default), pass plain text or Markdown as a string. With contentFormat \"adf\", pass an ADF JSON string or a document object with type \"doc\"."
          },
          "issueTypeName": {
            "type": "string",
            "description": "Type (Task, Bug, Story)"
          },
          "parent": {
            "type": "string",
            "description": "Parent for subtasks"
          },
          "projectKey": {
            "type": "string",
            "description": "Project key"
          },
          "responseContentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ]
          },
          "summary": {
            "type": "string"
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "cloudId",
          "projectKey",
          "issueTypeName",
          "summary"
        ]
      }
    },
    {
      "name": "getJiraProjectIssueTypesMetadata",
      "description": "Get issue types",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "description": "Cloud ID (UUID or site URL)",
            "type": "string"
          },
          "maxResults": {
            "default": 50,
            "maximum": 200,
            "type": "number"
          },
          "projectIdOrKey": {
            "type": "string"
          },
          "startAt": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "cloudId",
          "projectIdOrKey"
        ]
      }
    },
    {
      "name": "getJiraIssueTypeMetaWithFields",
      "description": "Get field metadata",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "description": "Cloud ID (UUID or site URL)",
            "type": "string"
          },
          "issueTypeId": {
            "type": "string"
          },
          "maxResults": {
            "type": "number"
          },
          "projectIdOrKey": {
            "type": "string"
          },
          "requiredFieldsOnly": {
            "description": "When true (default), returns only the fields that are required to create an issue of this type, reducing response size. Set to false to return all available fields (both required and optional).",
            "type": "boolean"
          },
          "startAt": {
            "type": "number"
          }
        },
        "required": [
          "cloudId",
          "projectIdOrKey",
          "issueTypeId"
        ]
      }
    },
    {
      "name": "addCommentToJiraIssue",
      "description": "Add or update a comment on a Jira issue",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "commentBody": {
            "type": "string",
            "description": "Comment body"
          },
          "commentId": {
            "type": "string",
            "maxLength": 18,
            "description": "ID of an existing comment to update. If omitted, a new comment is added."
          },
          "commentVisibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "group",
                  "role"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ],
            "description": "Content format for body content. Use \"markdown\" for simplified plain text. Use \"adf\" (Atlassian Document Format, JSON) for full programmatic fidelity. Defaults vary by tool when omitted."
          },
          "issueIdOrKey": {
            "type": "string",
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)"
          },
          "responseContentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ]
          }
        },
        "required": [
          "cloudId",
          "issueIdOrKey",
          "commentBody"
        ]
      }
    },
    {
      "name": "createIssueLink",
      "description": "Create a link between two Jira issues. For directional link types (e.g. Blocks): inwardIssue = issue that blocks, outwardIssue = issue that is blocked (e.g. \"A is blocked by B\" → inwardIssue: B, outwardIssue: A). Use getIssueLinkTypes if link type is unknown.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "comment": {
            "type": "string",
            "description": "Optional comment on the outward issue."
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "markdown",
              "adf"
            ]
          },
          "inwardIssue": {
            "type": "string",
            "description": "Inward issue key (e.g. HSP-1)."
          },
          "outwardIssue": {
            "type": "string",
            "description": "Outward issue key (e.g. MKY-1)."
          },
          "type": {
            "type": "string",
            "description": "Link type name (e.g. Duplicate, Blocks, Clones, Relates). Use getIssueLinkTypes to list available types."
          }
        },
        "required": [
          "cloudId",
          "inwardIssue",
          "outwardIssue",
          "type"
        ]
      }
    },
    {
      "name": "getTransitionsForJiraIssue",
      "description": "Get transitions",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionSource": {
            "type": "string",
            "enum": [
              "jira_mcp_card",
              "model_tool_call"
            ],
            "description": "Invocation attribution. Set to jira_mcp_card when called from a Jira MCP Widget UI; omit or set to model_tool_call for model/tool-loop calls."
          },
          "cloudId": {
            "type": "string",
            "description": "Cloud ID (UUID or site URL)"
          },
          "expand": {
            "type": "string"
          },
          "includeUnavailableTransitions": {
            "type": "boolean"
          },
          "issueIdOrKey": {
            "type": "string",
            "description": "Issue ID or key (e.g., PROJ-123 or 10000)"
          },
          "skipRemoteOnlyCondition": {
            "type": "boolean"
          },
          "sortByOpsBarAndStatus": {
            "type": "boolean"
          },
          "transitionId": {
            "type": "string"
          }
        },
        "required": [
