{
  "getJiraIssue": {
    "tools": [
      {
        "tool": "getJiraIssue",
        "tier": "primaria"
      }
    ],
    "params": "fields + fieldsByKeys, view: evidence (issuelinks), expand: changelog / renderedFields",
    "format": "markdown o html; color solo en renderedFields"
  },
  "getTransitionsForJiraIssue": {
    "tools": [
      {
        "tool": "listJiraIssueTransitions",
        "tier": "executeRead"
      }
    ],
    "params": "issueIdOrKey",
    "format": "transitions[].to.name"
  },
  "transitionJiraIssue": {
    "tools": [
      {
        "tool": "transitionJiraIssue",
        "tier": "primaria"
      }
    ],
    "params": "transitionId",
    "format": "devuelve el status final"
  },
  "addCommentToJiraIssue": {
    "tools": [
      {
        "tool": "addOrEditJiraIssueComment",
        "tier": "primaria"
      }
    ],
    "params": "commentBody, contentFormat markdown|html, commentId para editar",
    "format": "markdown o html"
  },
  "addWorklogToJiraIssue": {
    "tools": [
      {
        "tool": "addOrEditJiraIssueWorklog",
        "tier": "executeWrite"
      }
    ],
    "params": "timeSpent, started, worklogId para editar",
    "format": "—"
  },
  "getWorklogsForJiraIssue": {
    "tools": [
      {
        "tool": "listJiraIssueWorklogs",
        "tier": "executeRead"
      }
    ],
    "params": "issueIdOrKey, startAt, maxResults",
    "format": "worklogs[].id + started + timeSpent"
  },
  "createIssueLink": {
    "tools": [
      {
        "tool": "createJiraIssueLink",
        "tier": "executeWrite"
      }
    ],
    "params": "linkType, inwardIssue (bloquea), outwardIssue (bloqueado)",
    "format": "—"
  },
  "createJiraIssue": {
    "tools": [
      {
        "tool": "createJiraIssue",
        "tier": "primaria"
      }
    ],
    "params": "contentFormat html, parent, priority, labels, additional_fields {fixVersions, timetracking, duedate, components}",
    "format": "markdown o html (no ADF)"
  },
  "searchJiraIssuesUsingJql": {
    "tools": [
      {
        "tool": "searchJiraIssuesUsingJql",
        "tier": "primaria"
      }
    ],
    "params": "jql, fields, maxResults, nextPageToken",
    "format": "pageInfo.hasNextPage + endCursor"
  },
  "getJiraProjectIssueTypesMetadata": {
    "tools": [
      {
        "tool": "listJiraProjectIssueTypesMetadata",
        "tier": "executeRead"
      }
    ],
    "params": "projectIdOrKey",
    "format": "issueTypes[].id"
  },
  "getJiraIssueTypeMetaWithFields": {
    "tools": [
      {
        "tool": "getJiraIssueTypeMetaWithFields",
        "tier": "executeRead"
      }
    ],
    "params": "projectIdOrKey, issueTypeId, requiredFieldsOnly: false",
    "format": "allowedValues de fixVersions con released"
  },
  "manageJiraProjectVersion": {
    "tools": [
      {
        "tool": "manageJiraProjectVersion",
        "tier": "executeDestructive"
      }
    ],
    "params": "action create (projectIdOrKey, name, releaseDate) | update|release|archive (versionId, releaseDate)",
    "format": "—"
  },
  "lookupJiraAccountId": {
    "tools": [
      {
        "tool": "lookupJiraAccountId",
        "tier": "executeRead"
      },
      {
        "tool": "atlassianUserInfo",
        "tier": "primaria"
      }
    ],
    "params": "query",
    "format": "accountId"
  },
  "getConfluenceSpaces": {
    "tools": [
      {
        "tool": "getConfluenceSpace",
        "tier": "executeRead"
      }
    ],
    "params": "spaceIdOrKey",
    "format": "id, homepageId"
  },
  "getConfluencePageDescendants": {
    "tools": [
      {
        "tool": "getConfluenceContentDescendants",
        "tier": "executeRead"
      }
    ],
    "params": "contentId, depth, limit 250, cursor",
    "format": "id, type (page|folder), parentId, depth"
  },
  "getConfluencePage": {
    "tools": [
      {
        "tool": "getConfluenceContent",
        "tier": "primaria"
      }
    ],
    "params": "content_id, content_format html, detail full",
    "format": "html con data-local-id + snapshotToken"
  },
  "createConfluencePage": {
    "tools": [
      {
        "tool": "createConfluenceContent",
        "tier": "primaria"
      }
    ],
    "params": "contentType live_doc, parent {spaceId, parentContentId}, title, body {format html}",
    "format": "html o markdown (no ADF)"
  },
  "updateConfluencePage": {
    "tools": [
      {
        "tool": "updateConfluenceContent",
        "tier": "primaria"
      }
    ],
    "params": "contentId, snapshotToken, body {format html} o edits [replaceNode, insertNodeAfter, insertNodeBefore, deleteNode, appendNodeToEnd, moveNode, setAttrs]",
    "format": "html o markdown (no ADF)"
  },
  "getConfluenceDatabase": {
    "tools": [
      {
        "tool": "getConfluenceContent",
        "tier": "primaria"
      }
    ],
    "params": "content_id, content_format csv",
    "format": "csv con snapshotToken"
  },
  "updateConfluenceDatabase": {
    "tools": [
      {
        "tool": "updateConfluenceContent",
        "tier": "primaria"
      }
    ],
    "params": "contentId, snapshotToken, body {format csv, value: sobre de edición, context: {content: csv actual}}",
    "format": "—"
  },
  "setConfluenceContentStatus": {
    "tools": [
      {
        "tool": "setConfluenceContentStatus",
        "tier": "executeWrite"
      }
    ],
    "params": "contentId, name, color",
    "format": "contentState {name}"
  },
  "getConfluenceContentStatus": {
    "tools": [
      {
        "tool": "getConfluenceContentStatus",
        "tier": "executeRead"
      }
    ],
    "params": "contentId",
    "format": "contentState {name}"
  }
}